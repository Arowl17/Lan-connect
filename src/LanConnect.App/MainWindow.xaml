<Window x:Class="LanConnect.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Lan Connect" Width="720" Height="860" MinWidth="560" MinHeight="400"
        Icon="Assets/app.ico" WindowStartupLocation="CenterScreen" Style="{StaticResource AppWindow}">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="24,20,24,12">

            <!-- Header -->
            <DockPanel Margin="0,0,0,16">
                <Image Source="Assets/app.png" Width="44" Height="44" RenderOptions.BitmapScalingMode="HighQuality" DockPanel.Dock="Left" Margin="0,0,14,0" />
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="Lan Connect" FontSize="24" FontWeight="SemiBold" />
                    <StackPanel Orientation="Horizontal" Margin="0,2,0,0">
                        <Ellipse x:Name="StatusDot" Width="9" Height="9" Margin="0,0,7,0" VerticalAlignment="Center" Fill="{StaticResource Muted}" />
                        <TextBlock x:Name="StatusText" Foreground="{StaticResource TextSecondary}" TextWrapping="Wrap" />
                    </StackPanel>
                </StackPanel>
            </DockPanel>

            <!-- Firewall warning -->
            <Border x:Name="FirewallBanner" Visibility="Collapsed" Background="{StaticResource WarningBackground}"
                    CornerRadius="8" Padding="14,10" Margin="0,0,0,14">
                <DockPanel>
                    <Button DockPanel.Dock="Right" Content="Fix it" Style="{StaticResource PrimaryButton}" Click="OnFixFirewall" Margin="12,0,0,0" />
                    <TextBlock TextWrapping="Wrap" VerticalAlignment="Center">
                        Windows Firewall may block Lan Connect, so your other computer might not be able to connect.
                        Click "Fix it" and approve the prompt.
                    </TextBlock>
                </DockPanel>
            </Border>

            <!-- First run -->
            <Border x:Name="WelcomeCard" Style="{StaticResource Card}">
                <StackPanel>
                    <TextBlock Text="Welcome! Three steps and you're done" Style="{StaticResource CardTitle}" />
                    <TextBlock Style="{StaticResource Hint}" Margin="0,6,0,0">1.  Install and open Lan Connect on your other computer (same Wi-Fi or network).</TextBlock>
                    <TextBlock Style="{StaticResource Hint}" Margin="0,4,0,0">2.  It appears under "Nearby computers" below. Click Pair and confirm the same code on both screens.</TextBlock>
                    <TextBlock Style="{StaticResource Hint}" Margin="0,4,0,0">3.  Pick which side of this computer it sits on. Then just move your mouse across the edge.</TextBlock>
                    <Button Content="Got it" Style="{StaticResource SecondaryButton}" HorizontalAlignment="Left" Margin="0,12,0,0" Click="OnDismissWelcome" />
                </StackPanel>
            </Border>

            <!-- Devices -->
            <Border Style="{StaticResource Card}">
                <StackPanel>
                    <TextBlock Text="Your computers" Style="{StaticResource CardTitle}" />
                    <TextBlock x:Name="NoDevicesText" Style="{StaticResource Hint}" Text="No computers paired yet." Margin="0,2,0,6" />
                    <ItemsControl x:Name="DeviceList">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border BorderBrush="{StaticResource CardBorder}" BorderThickness="0,1,0,0" Padding="0,12,0,8">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel VerticalAlignment="Center">
                                            <TextBlock Text="{Binding Name}" FontWeight="SemiBold" />
                                            <StackPanel Orientation="Horizontal" Margin="0,3,0,0">
                                                <Ellipse Width="8" Height="8" Fill="{Binding StatusBrush}" Margin="0,0,6,0" VerticalAlignment="Center" />
                                                <TextBlock Text="{Binding StatusText}" Style="{StaticResource Hint}" />
                                            </StackPanel>
                                        </StackPanel>
                                        <ComboBox Grid.Column="1" Width="200" Margin="12,0" VerticalAlignment="Center"
                                                  ItemsSource="{Binding PlacementOptions}" SelectedIndex="{Binding PlacementIndex, Mode=OneWay}"
                                                  Tag="{Binding Id}" SelectionChanged="OnPlacementChanged" ToolTip="Where this computer sits next to your screens" />
                                        <Button Grid.Column="2" Content="Forget" Style="{StaticResource SecondaryButton}" VerticalAlignment="Center"
                                                Tag="{Binding Id}" Click="OnForget" />
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <TextBlock Text="Nearby computers" FontWeight="SemiBold" Margin="0,16,0,4" />
                    <TextBlock x:Name="NoNearbyText" Style="{StaticResource Hint}"
                               Text="Searching... Make sure Lan Connect is open on your other computer and both are on the same network." />
                    <ItemsControl x:Name="NearbyList">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border BorderBrush="{StaticResource CardBorder}" BorderThickness="0,1,0,0" Padding="0,10,0,6">
                                    <DockPanel>
                                        <Button DockPanel.Dock="Right" Content="Pair" Style="{StaticResource PrimaryButton}" Tag="{Binding}" Click="OnPair" VerticalAlignment="Center" />
                                        <StackPanel VerticalAlignment="Center">
                                            <TextBlock Text="{Binding Name}" FontWeight="SemiBold" />
                                            <TextBlock Text="{Binding Address}" Style="{StaticResource Hint}" />
                                        </StackPanel>
                                    </DockPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <DockPanel Margin="0,14,0,0">
                        <Button DockPanel.Dock="Right" Content="Pair" Style="{StaticResource SecondaryButton}" Click="OnPairManual" />
                        <TextBox x:Name="ManualAddress" DockPanel.Dock="Right" Width="170" Margin="8,0" VerticalContentAlignment="Center" />
                        <TextBlock Text="Not listed? Pair by IP address:" Style="{StaticResource Hint}" VerticalAlignment="Center" />
                    </DockPanel>
                </StackPanel>
            </Border>

            <!-- Switching -->
            <Border Style="{StaticResource Card}">
                <StackPanel>
                    <TextBlock Text="Switching" Style="{StaticResource CardTitle}" />
                    <TextBlock Style="{StaticResource Hint}">
                        Push the mouse past the screen edge toward the other computer, or press the hotkey with the arrow key pointing at it.
                        Corners never switch, and neither does dragging something with a mouse button held.
                    </TextBlock>
                    <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                        <TextBlock Text="Hotkey" Width="140" VerticalAlignment="Center" />
                        <CheckBox x:Name="HotkeyCtrl" Content="Ctrl" Margin="0,0,14,0" Click="OnHotkeyChanged" />
                        <CheckBox x:Name="HotkeyAlt" Content="Alt" Margin="0,0,14,0" Click="OnHotkeyChanged" />
                        <CheckBox x:Name="HotkeyShift" Content="Shift" Margin="0,0,14,0" Click="OnHotkeyChanged" />
                        <CheckBox x:Name="HotkeyWin" Content="Win" Margin="0,0,14,0" Click="OnHotkeyChanged" />
                        <TextBlock Text="+ arrow key" VerticalAlignment="Center" Foreground="{StaticResource TextSecondary}" />
                    </StackPanel>
                    <DockPanel Margin="0,14,0,0">
                        <TextBlock Text="Edge resistance" Width="140" VerticalAlignment="Center" />
                        <TextBlock x:Name="PushValue" DockPanel.Dock="Right" Width="110" Margin="10,0,0,0" VerticalAlignment="Center" Foreground="{StaticResource TextSecondary}" />
                        <Slider x:Name="PushSlider" Minimum="0" Maximum="80" TickFrequency="5" IsSnapToTickEnabled="True" VerticalAlignment="Center" ValueChanged="OnPushChanged" />
                    </DockPanel>
                    <DockPanel Margin="0,8,0,0">
                        <TextBlock Text="Dead corners" Width="140" VerticalAlignment="Center" />
                        <TextBlock x:Name="CornerValue" DockPanel.Dock="Right" Width="110" Margin="10,0,0,0" VerticalAlignment="Center" Foreground="{StaticResource TextSecondary}" />
                        <Slider x:Name="CornerSlider" Minimum="0" Maximum="150" TickFrequency="10" IsSnapToTickEnabled="True" VerticalAlignment="Center" ValueChanged="OnCornerChanged" />
                    </DockPanel>
                </StackPanel>
            </Border>

            <!-- Clipboard -->
            <Border Style="{StaticResource Card}">
                <StackPanel>
                    <TextBlock Text="Clipboard" Style="{StaticResource CardTitle}" />
                    <TextBlock Style="{StaticResource Hint}">
                        Copy on one computer, move the mouse over, paste on the other. Works for text, images and files
                        in both directions. Received files are kept until you copy something else.
                    </TextBlock>
                    <CheckBox x:Name="ClipboardEnabled" Content="Bring the clipboard along when switching computers" FontWeight="SemiBold" Margin="0,10,0,0" Click="OnClipboardChanged" />
                    <StackPanel x:Name="ClipboardOptionsPanel" Margin="24,0,0,0">
                        <CheckBox x:Name="ClipboardFiles" Content="Include copied files and folders" Click="OnClipboardChanged" />
                        <DockPanel Margin="0,10,0,0">
                            <TextBlock Text="Largest file transfer" Width="170" VerticalAlignment="Center" />
                            <ComboBox x:Name="ClipboardLimit" Width="140" HorizontalAlignment="Left" SelectionChanged="OnClipboardLimitChanged">
                                <ComboBoxItem Content="100 MB" Tag="100" />
                                <ComboBoxItem Content="500 MB" Tag="500" />
                                <ComboBoxItem Content="1 GB" Tag="1024" />
                                <ComboBoxItem Content="4 GB" Tag="4096" />
                                <ComboBoxItem Content="16 GB" Tag="16384" />
                            </ComboBox>
                        </DockPanel>
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- Game mode -->
            <Border Style="{StaticResource Card}">
                <StackPanel>
                    <TextBlock Text="Game mode" Style="{StaticResource CardTitle}" />
                    <TextBlock Style="{StaticResource Hint}">
                        While you play, the screen edges never switch computers (the hotkey still works), and Lan Connect stops
                        watching the mouse entirely so your games get untouched input. Press Esc to open the game's menu and the
                        mouse is free again.
                    </TextBlock>
                    <CheckBox x:Name="GameEnabled" Content="Turn on game mode" FontWeight="SemiBold" Margin="0,10,0,0" Click="OnGameModeChanged" />
                    <StackPanel x:Name="GameOptions" Margin="24,0,0,0">
                        <CheckBox x:Name="GameHidden" Content="When a game hides the cursor (aiming, looking around)" Click="OnGameModeChanged" />
                        <CheckBox x:Name="GameLocked" Content="When the cursor is locked inside a window" Click="OnGameModeChanged" />
                        <CheckBox x:Name="GameFullscreen" Content="When a fullscreen app is focused" Click="OnGameModeChanged" />
                        <CheckBox x:Name="GameKeepOnScreen" Content="Keep the mouse on the game's screen while I play" Margin="0,10,0,0" Click="OnGameModeChanged" />
                        <CheckBox x:Name="GameFreeOnEscape" Content="Free the mouse while the game's menu is open (Esc)" Click="OnGameModeChanged" />
                        <TextBlock Style="{StaticResource Hint}" Margin="24,2,0,0"
                                   Text="Esc opens the menu and Esc closes it again. Walking (holding W, A, S or D) also counts as playing." />
                        <TextBlock Text="Always in these apps and windows:" Margin="0,14,0,4" />
                        <ItemsControl x:Name="GameList">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <DockPanel Margin="0,2">
                                        <Button DockPanel.Dock="Right" Content="Remove" Style="{StaticResource SecondaryButton}" Padding="10,2" Tag="{Binding}" Click="OnRemoveGame" />
                                        <TextBlock Text="{Binding}" VerticalAlignment="Center" />
                                    </DockPanel>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <DockPanel Margin="0,8,0,0">
                            <Button DockPanel.Dock="Right" Content="Add" Style="{StaticResource SecondaryButton}" Click="OnAddGame" />
                            <TextBox x:Name="GameEntry" Margin="0,0,8,0" VerticalContentAlignment="Center" KeyDown="OnGameEntryKeyDown" />
                        </DockPanel>
                        <TextBlock Style="{StaticResource Hint}" Margin="0,4,0,0"
                                   Text="A program name such as game.exe, or part of a window title such as GeForce NOW." />
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- General -->
            <Border Style="{StaticResource Card}">
                <StackPanel>
                    <TextBlock Text="General" Style="{StaticResource CardTitle}" />
                    <DockPanel Margin="0,6,0,0">
                        <TextBlock Text="This computer's name" Width="170" VerticalAlignment="Center" />
                        <TextBox x:Name="DeviceName" VerticalContentAlignment="Center" LostFocus="OnDeviceNameCommitted" KeyDown="OnDeviceNameKeyDown" />
                    </DockPanel>
                    <CheckBox x:Name="StartWithWindows" Content="Start Lan Connect when I sign in to Windows" Margin="0,12,0,0" Click="OnGeneralChanged" />
                    <CheckBox x:Name="VisibleOnNetwork" Content="Let other computers on this network find this one" Click="OnGeneralChanged" />
                    <CheckBox x:Name="AllowPairing" Content="Allow pairing requests (a code is always confirmed on both screens)" Click="OnGeneralChanged" />
                    <DockPanel Margin="0,14,0,0">
                        <Button DockPanel.Dock="Right" Content="Open log folder" Style="{StaticResource SecondaryButton}" Click="OnOpenLogs" />
                        <TextBlock x:Name="AboutText" Style="{StaticResource Hint}" VerticalAlignment="Center" />
                    </DockPanel>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</Window>
