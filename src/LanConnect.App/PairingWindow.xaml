<Window x:Class="LanConnect.App.PairingWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Pair computers - Lan Connect" Width="460" SizeToContent="Height"
        ResizeMode="NoResize" Icon="Assets/app.ico" WindowStartupLocation="CenterScreen" Topmost="True"
        Style="{StaticResource AppWindow}">
    <Border Padding="28,24">
        <StackPanel>
            <!-- Step 1: compare codes -->
            <StackPanel x:Name="CodePanel">
                <TextBlock x:Name="CodeTitle" FontSize="20" FontWeight="SemiBold" TextWrapping="Wrap" />
                <TextBlock x:Name="CodeHint" Style="{StaticResource Hint}" FontSize="14" Margin="0,8,0,0" />
                <Border Background="{StaticResource CardBackground}" BorderBrush="{StaticResource CardBorder}" BorderThickness="1"
                        CornerRadius="10" Padding="0,18" Margin="0,18,0,18">
                    <TextBlock x:Name="CodeText" FontSize="44" FontWeight="SemiBold" HorizontalAlignment="Center"
                               FontFamily="Cascadia Mono, Consolas" />
                </Border>
                <TextBlock x:Name="WaitingText" Style="{StaticResource Hint}" Visibility="Collapsed" Margin="0,0,0,12" />
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button x:Name="CancelButton" Content="Cancel" Style="{StaticResource SecondaryButton}" Margin="0,0,10,0" Click="OnCancel" />
                    <Button x:Name="ConfirmButton" Content="The codes match" Style="{StaticResource PrimaryButton}" Click="OnConfirm" IsDefault="True" />
                </StackPanel>
            </StackPanel>

            <!-- Step 2: placement -->
            <StackPanel x:Name="PlacementPanel" Visibility="Collapsed">
                <TextBlock x:Name="PlacementTitle" FontSize="20" FontWeight="SemiBold" TextWrapping="Wrap" />
                <TextBlock x:Name="PlacementHint" Style="{StaticResource Hint}" FontSize="14" Margin="0,8,0,16"
                           Text="Pick the side where it physically sits next to your screens. You can change it later in Settings." />
                <Grid HorizontalAlignment="Center" Margin="0,0,0,18">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="110" />
                        <ColumnDefinition Width="140" />
                        <ColumnDefinition Width="110" />
                    </Grid.ColumnDefinitions>
                    <Button x:Name="PlaceTop" Grid.Row="0" Grid.Column="1" Content="Above" Style="{StaticResource SecondaryButton}" Margin="6" Tag="Top" Click="OnPlace" />
                    <Button x:Name="PlaceLeft" Grid.Row="1" Grid.Column="0" Content="Left" Style="{StaticResource SecondaryButton}" Margin="6" Tag="Left" Click="OnPlace" />
                    <Border Grid.Row="1" Grid.Column="1" Background="{StaticResource Accent}" CornerRadius="8" Height="72" Margin="6">
                        <TextBlock Text="This computer" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center" FontWeight="SemiBold" />
                    </Border>
                    <Button x:Name="PlaceRight" Grid.Row="1" Grid.Column="2" Content="Right" Style="{StaticResource SecondaryButton}" Margin="6" Tag="Right" Click="OnPlace" />
                    <Button x:Name="PlaceBottom" Grid.Row="2" Grid.Column="1" Content="Below" Style="{StaticResource SecondaryButton}" Margin="6" Tag="Bottom" Click="OnPlace" />
                </Grid>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button Content="Later" Style="{StaticResource SecondaryButton}" Click="OnDone" />
                </StackPanel>
            </StackPanel>

            <!-- Failure -->
            <StackPanel x:Name="FailedPanel" Visibility="Collapsed">
                <TextBlock Text="Not paired" FontSize="20" FontWeight="SemiBold" />
                <TextBlock x:Name="FailedText" Style="{StaticResource Hint}" FontSize="14" Margin="0,8,0,18" />
                <Button Content="Close" Style="{StaticResource PrimaryButton}" HorizontalAlignment="Right" Click="OnDone" />
            </StackPanel>
        </StackPanel>
    </Border>
</Window>
